{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "mkdir -p public && cp -R uploads public/uploads",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "uploads/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
